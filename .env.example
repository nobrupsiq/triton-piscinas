NEXT_PUBLIC_SITE_URL=https://tritonpiscinas.com.br
NEXT_PUBLIC_WHATSAPP=5521991215101
# Vazio usa as imagens locais em public/midia.
# Para um servidor de imagens, informe sua URL base sem / no final.
NEXT_PUBLIC_ASSET_BASE_URL=
# Repositório do GitHub (usuario/repositorio) para o painel /keystatic.
# Vazio, o painel só funciona com `npm run dev`, gravando nos arquivos locais.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Gerados pelo Keystatic ao criar o GitHub App (veja README, "Publicação").
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
